# Firebase client SDK (public, exposed to the browser)
# Firebase console -> Project settings -> General -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only, never expose to the browser)
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences on ONE line, for example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Comma-separated list of admin emails allowed to access the dashboard
# Example: ADMIN_EMAILS=owner@example.com,manager@example.com
ADMIN_EMAILS=

# Cloudinary (cloud name is public; key/secret are server-only)
# Cloudinary console -> Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storefront WhatsApp number in international format (public)
# Example: NEXT_PUBLIC_WHATSAPP_NUMBER=+201088346667
NEXT_PUBLIC_WHATSAPP_NUMBER=
